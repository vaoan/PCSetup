# =============================================================================
# Secrets file — populated by sync-secrets.bat or manually
# =============================================================================
# This file holds actual secret values. It is gitignored and never committed.
#
# To populate automatically from GitHub repository secrets:
#   sync-secrets.bat
#
# Or copy this file and fill in values manually:
#   copy .secrets.example .secrets
#
# Format: KEY=VALUE (one per line, # for comments)
# =============================================================================

# =============================================================================
# First-time setup (run once after a fresh Windows install)
# =============================================================================
# 1. Generate a strong passphrase and save it to %USERPROFILE%\.pcsetup-sync-passphrase:
#      $p = -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#      Set-Content -Path "$env:USERPROFILE\.pcsetup-sync-passphrase" -Value $p -NoNewline
#      Write-Host "Add this as SYNC_PASSPHRASE in GitHub Secrets: $p"
# 2. Add SYNC_PASSPHRASE to GitHub → Settings → Secrets and variables → Actions
# =============================================================================

# ─── ffxivbe.org (cloudflared) ───────────────────────────────────────────────
# PEM cert/key stored as base64 to avoid multiline issues in GitHub Secrets.
# Encode:  [Convert]::ToBase64String([IO.File]::ReadAllBytes('ffxivbe.pem')) | clip
# Decode:  [IO.File]::WriteAllBytes('ffxivbe.pem', [Convert]::FromBase64String($env:FFXIVBE_PEM_B64))
FFXIVBE_PEM_B64=replace_me

# Cloudflared tunnel token for ffxivbe.org
CLOUDFLARE_TUNNEL_TOKEN=replace_me

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token — useful for authenticated git operations on fresh installs
GH_PAT=replace_me

# ─── Web console (sshwifty) ───────────────────────────────────────────────────
# sshwifty.conf.json — embed SSH private keys for all console presets.
# Encode:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("$env:USERPROFILE\Documents\Cloudflare\sshwifty\sshwifty.conf.json")) | clip
# Then add it as SSHWIFTY_CONF_B64 in GitHub → Settings → Secrets and variables → Actions
#
# NOTE: Cloudflare tunnel is provisioned automatically by setup-console-windows.ps1
# using cert.pem from `cloudflared tunnel login` — no tunnel credentials secret needed.
SSHWIFTY_CONF_B64=replace_me

# ─── Cloudflare Zero Trust ────────────────────────────────────────────────────
# API token with Zero Trust edit permissions — used by setup-console-windows.ps1
# to create/manage Access applications for each console hostname.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Custom Token
# Permission: Account → Cloudflare Zero Trust → Edit
CLOUDFLARE_FFXIVBE_ZERO_TRUST_API_TOKEN=replace_me

# ─── Cloudflare account admin ─────────────────────────────────────────────────
# Broad account-scoped API token (Edit) covering: DNS Views, DNS Settings, DNS
# Firewall, SSL/Certificates, WAF, Cloudflare Tunnel, Workers Scripts, Account
# Settings, Zero Trust, and Access (Service Tokens, Orgs/IdPs/Groups, Apps/Policies).
# Use for scripting tunnel + DNS + Worker provisioning without `wrangler login`
# or `cloudflared tunnel login`.
# Verify:  curl -H "Authorization: Bearer $CLOUDFLARE_ACCOUNT_API_TOKEN" \
#            https://api.cloudflare.com/client/v4/user/tokens/verify
CLOUDFLARE_ACCOUNT_API_TOKEN=replace_me
