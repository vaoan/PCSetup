# Spotify → Discord bridge environment.
# cloud/setup-cloud.sh writes the real file to /etc/spotify-discord.env on the
# VPS, pulling values from the repo .secrets when present. This is just a reference.

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_BOT_TOKEN=replace_me

# Your Discord server (guild) id — right-click the server icon → Copy Server ID
# (enable Developer Mode in Discord settings first).
DISCORD_GUILD_ID=replace_me

# Voice channel the bot auto-joins on startup — right-click the voice channel →
# Copy Channel ID. Leave as replace_me to instead join on demand with /join.
DISCORD_VOICE_CHANNEL_ID=replace_me

# Named pipe go-librespot writes to (must match config.yml audio_output_pipe).
SPOTIFY_FIFO=/tmp/spotify-discord.fifo

# Sample rate go-librespot writes (go-librespot pipe output is 44100 Hz stereo).
SPOTIFY_PIPE_RATE=44100

# ─── Audio quality / resilience (all optional; sensible defaults in bot.js) ───
# Opus bitrate in bits/s. Auto-capped to the voice channel's own limit (96k
# unboosted; 128/256/384k at boost tiers 1/2/3). Raise if your server is boosted.
SPOTIFY_OPUS_BITRATE=128000
# Inband Forward Error Correction (1=on) — recovers from brief packet loss.
SPOTIFY_OPUS_FEC=1
# Expected packet-loss fraction FEC optimises for (0..1).
SPOTIFY_OPUS_PLP=0.05
# ffmpeg 44.1→48kHz resampler: soxr = high quality. Set empty to use the default.
SPOTIFY_RESAMPLER=soxr

# Auto-leave voice when only bots remain (no humans), after this many seconds.
# Counts real people only — TTS/other music bots don't count. 0 disables.
EMPTY_DISCONNECT_SECONDS=90

# ─── DJ / search (optional) ───────────────────────────────────────────────────
# Spotify app credentials for /play and /radio by song NAME (client-credentials,
# no user login). Create an app at https://developer.spotify.com/dashboard.
# Without these, /play and /radio accept Spotify links only, and a song name
# typed into /play searches YouTube instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── YouTube source (optional; defaults in youtube.js) ────────────────────────
# Netscape cookies.txt from a signed-in YouTube session. Without it the VPS IP
# fails YouTube's bot check for almost every video (SD-015). Installed by
# cloud/set-youtube-cookies.ps1; the bot writes refreshed cookies back to it.
YOUTUBE_COOKIES=/etc/spotify-discord/youtube-cookies.txt
# yt-dlp (setup-cloud.sh installs the zipapp release here; it runs on python3).
YTDLP_BIN=/usr/local/bin/yt-dlp
# JS runtime yt-dlp uses to run YouTube's player code.
YTDLP_JS_RUNTIME=node
# Most entries taken from one YouTube playlist link.
YOUTUBE_PLAYLIST_LIMIT=100
