# escape=`
FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", `
    "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

# CI mode: skips profile folder move (5), games (6), Defender checks (10)
ENV PCSETUP_CI=1

ARG BRANCH=main

# Run the remote install — use scriptblock so param() binding works and -Branch is honoured
RUN $url = ('https://i.ffxiv.be/?branch=' + $env:BRANCH); `
    Write-Host ('Fetching ' + $url) -ForegroundColor Cyan; `
    & ([scriptblock]::Create((Invoke-RestMethod -Uri $url -UseBasicParsing))) -Branch $env:BRANCH

# Copy the repository and run only the container-safe, non-Cloudflare suite
COPY . C:/workspace/
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:/workspace/tests/run-tests.ps1 -Path C:/workspace/tests/container.tests.ps1
